{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "version": "1.0.0",
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^v3.5.1",
        "laracasts/flash": "^3.2.6",
        "laravel/fortify": "^v1.41.0",
        "laravel/framework": "^v13.35.0",
        "laravel/tinker": "^v3.0.2",
        "laravel/wayfinder": "^0.1.21",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "spatie/laravel-medialibrary": "^11.23.9"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^v4.4.4",
        "fakerphp/faker": "^v1.24.1",
        "larastan/larastan": "^v3.13.0",
        "laravel/pint": "^v1.32.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^v8.9.5",
        "pestphp/pest": "^v5.3.1",
        "pestphp/pest-plugin-laravel": "^v5.0.1",
        "pestphp/pest-plugin-type-coverage": "^v5.0.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
